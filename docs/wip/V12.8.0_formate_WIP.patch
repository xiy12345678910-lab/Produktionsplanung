+def _validate_machine_format_fields(m: dict) -> tuple[bool, str]:
+    """Tiefziehen: Takte je Maschine (Name + Sekunden) und maximale Formatgröße/Ziehtiefe."""
+    for f in ("maxL", "maxB", "maxH"):
